{
  "title": "Schema Lens Run Health",
  "panels": [
    {
      "title": "Runs Total",
      "type": "stat",
      "targets": [{"expr": "schema_lens_runs_total"}]
    },
    {
      "title": "Failed Runs",
      "type": "stat",
      "targets": [{"expr": "schema_lens_runs_failed_total"}]
    },
    {
      "title": "High Risk Queries",
      "type": "stat",
      "targets": [{"expr": "schema_lens_high_risk_queries_total"}]
    },
    {
      "title": "P95 Latency Regression %",
      "type": "timeseries",
      "targets": [{"expr": "schema_lens_p95_latency_regression_pct"}]
    }
  ]
}
