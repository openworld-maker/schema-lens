<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SolrGuard Report</title>
  <style>
    :root {
      --bg: #f4f6f8;
      --panel: #ffffff;
      --text: #10212b;
      --muted: #50616d;
      --danger: #c02f1d;
      --warn: #ab6b00;
      --ok: #176f45;
      --border: #d9e1e7;
    }
    body {
      margin: 0;
      background: radial-gradient(circle at top right, #d9edf7 0%, var(--bg) 40%);
      color: var(--text);
      font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
    }
    .container { max-width: 1080px; margin: 0 auto; padding: 24px; }
    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.05);
    }
    h1, h2 { margin-top: 0; }
    table { width: 100%; border-collapse: collapse; }
    th, td { border-bottom: 1px solid var(--border); text-align: left; padding: 8px; font-size: 14px; }
    .risk-HIGH { color: var(--danger); font-weight: 700; }
    .risk-MEDIUM { color: var(--warn); font-weight: 700; }
    .risk-LOW { color: var(--ok); font-weight: 700; }
    .muted { color: var(--muted); }
    pre {
      background: #0f1720;
      color: #d9ecff;
      border-radius: 10px;
      padding: 12px;
      overflow-x: auto;
      font-size: 12px;
    }
    details { margin-bottom: 10px; }
    summary { cursor: pointer; font-weight: 600; }
    .plugin-section {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 10px;
      background: #fefefe;
    }
    .plugin-section h3 {
      margin: 0 0 8px;
      font-size: 1rem;
    }
    .plugin-section .plugin-html {
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="card">
      <h1>SolrGuard Report</h1>
      <p class="muted">Run ID: {{ report.run_manifest.run_id }}</p>
      <p class="muted">Started: {{ report.run_manifest.started_at }} | Ended: {{ report.run_manifest.ended_at }}</p>
      <p class="muted">Snapshot Hash: {{ report.run_manifest.baseline.snapshot_hash if report.run_manifest.baseline else "n/a" }}</p>
      <p class="muted">Git Commit: {{ report.run_manifest.settings.git_commit if report.run_manifest.settings else "n/a" }}</p>
    </div>

    <div class="card" id="performance-cost-impact">
      <h2>Performance &amp; Cost Impact</h2>
      {% set perf = report.performance_cost_impact or {} %}
      {% if perf.enabled %}
      <pre>{{ perf }}</pre>
      {% else %}
      <p class="muted">{{ perf.reason if perf.reason else "Performance capture not enabled." }}</p>
      {% endif %}
    </div>

    <div class="card" id="root-cause-analysis">
      <h2>Root Cause Analysis</h2>
      {% set causes = report.root_causes or {} %}
      {% if causes.enabled %}
      <ul>
        {% for line in causes.summaries or [] %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
      <pre>{{ causes }}</pre>
      {% else %}
      <p class="muted">{{ causes.reason if causes.reason else "Root-cause analysis not available." }}</p>
      {% endif %}
    </div>

    <div class="card" id="recommendations">
      <h2>Recommendations</h2>
      {% set recs = report.recommendations or {} %}
      {% if recs.enabled %}
      <ul>
        {% for line in recs.summaries or [] %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
      <pre>{{ recs }}</pre>
      {% else %}
      <p class="muted">{{ recs.reason if recs.reason else "Recommendations not available." }}</p>
      {% endif %}
    </div>

    <div class="card" id="environment-drift">
      <h2>Environment Drift</h2>
      {% set envc = report.environment_compare or {} %}
      {% if envc.enabled %}
      <pre>{{ envc }}</pre>
      {% else %}
      <p class="muted">{{ envc.reason if envc.reason else "Environment compare not available." }}</p>
      {% endif %}
    </div>

    <div class="card" id="compatibility-summary">
      <h2>Compatibility &amp; Capability Summary</h2>
      {% set compat = report.compatibility or {} %}
      {% set compat_version = compat.version or {} %}
      {% if compat.solr_version or compat.env1 or compat.env2 %}
      {% if compat.solr_version %}
      <table>
        <tr><th>Detected Solr Version</th><td>{{ compat.solr_version }}</td></tr>
        <tr><th>Deployment Mode</th><td>{{ compat_version.deployment_mode if compat_version.deployment_mode else "unknown" }}</td></tr>
        <tr><th>Support Tier</th><td>{{ compat.support_tier if compat.support_tier else "unknown" }}</td></tr>
        <tr><th>Confidence</th><td>{{ compat.confidence if compat.confidence else "low" }}</td></tr>
      </table>
      {% endif %}
      {% if compat.missing_capabilities %}
      <p><strong>Missing Capabilities:</strong> {{ compat.missing_capabilities|join(", ") }}</p>
      {% endif %}
      {% if compat.disabled_features %}
      <p><strong>Disabled Features:</strong> {{ compat.disabled_features|join(", ") }}</p>
      {% endif %}
      {% if compat.fallbacks %}
      <h3>Fallbacks</h3>
      <ul>
        {% for fb in compat.fallbacks %}
        <li><code>{{ fb.feature }}</code> → <code>{{ fb.fallback }}</code> ({{ fb.reason }})</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if compat.capability_mismatches %}
      <h3>Cross-Environment Capability Mismatches</h3>
      <ul>
        {% for mm in compat.capability_mismatches %}
        <li><code>{{ mm.capability }}</code>: env1={{ mm.env1 }} env2={{ mm.env2 }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% else %}
      <p class="muted">Compatibility summary not available.</p>
      {% endif %}
    </div>

    <div class="card">
      <h2>Summary</h2>
      <table>
        <tr><th>Total Queries</th><td>{{ report.summary.queries_total }}</td></tr>
        <tr><th>Failures</th><td>{{ report.summary.failures }}</td></tr>
        <tr><th>Average Overlap</th><td>{{ "%.2f"|format(report.summary.avg_overlap) }}</td></tr>
        <tr><th>High Risk %</th><td>{{ "%.2f"|format(report.summary.high_risk_percent) }}</td></tr>
        <tr><th>Avg numFound Delta</th><td>{{ "%.2f"|format(report.summary.avg_numfound_delta) }}</td></tr>
        <tr><th>Avg Sort Instability</th><td>{{ "%.3f"|format(report.summary.avg_sort_instability_ratio) }}</td></tr>
        <tr><th>Queries With Facet Changes %</th><td>{{ "%.2f"|format(report.summary.queries_with_facet_changes_percent) }}</td></tr>
      </table>
    </div>

    <div class="card">
      <h2>Top Regressions</h2>
      <table>
        <thead>
          <tr>
            <th>Query ID</th>
            <th>Raw Query</th>
            <th>Risk</th>
            <th>Overlap</th>
            <th>Jaccard</th>
            <th>Kendall Tau</th>
            <th>numFound Δ</th>
            <th>Sort Instability</th>
          </tr>
        </thead>
        <tbody>
          {% for row in report.top_regressions %}
          <tr>
            <td>{{ row.query_id }}</td>
            <td>{{ row.raw_q }}</td>
            <td class="risk-{{ row.risk }}">{{ row.risk }}</td>
            <td>{{ row.overlap }}</td>
            <td>{{ "%.3f"|format(row.jaccard) if row.jaccard is not none else "n/a" }}</td>
            <td>{{ "%.3f"|format(row.kendall_tau) if row.kendall_tau is not none else "n/a" }}</td>
            <td>{{ row.numfound_delta if row.numfound_delta is not none else "n/a" }}</td>
            <td>{{ "%.3f"|format(row.sort_instability_ratio) if row.sort_instability_ratio is not none else "n/a" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>Schema Safety Findings</h2>
      {% set safety = report.schema_safety_findings or {} %}
      {% if safety.summary %}
      <table>
        <tr><th>Total</th><td>{{ safety.summary.total }}</td></tr>
        <tr><th>High</th><td>{{ safety.summary.high }}</td></tr>
        <tr><th>Medium</th><td>{{ safety.summary.medium }}</td></tr>
        <tr><th>Low</th><td>{{ safety.summary.low }}</td></tr>
        <tr><th>Block Run</th><td>{{ safety.block_run }}</td></tr>
      </table>
      {% else %}
      <p class="muted">No schema safety findings were recorded for this run.</p>
      {% endif %}
      {% for finding in safety.findings or [] %}
      <details>
        <summary>[{{ finding.severity }}] {{ finding.code }} - {{ finding.message }}</summary>
        <pre>{{ finding }}</pre>
      </details>
    {% endfor %}
  </div>

    {% if report.plugin_report_sections.html %}
    <div class="card">
      <h2>Plugin Sections</h2>
      {% for block in report.plugin_report_sections.html %}
      <div class="plugin-section">
        <h3>{{ block.plugin }}</h3>
        <div class="plugin-html">{{ block.html|safe }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    <div class="card">
      <h2>Query Rewrite Impact</h2>
      {% set rewrite = report.query_rewrite_impact or {} %}
      {% if rewrite.enabled %}
      <table>
        <tr><th>Debug Mode</th><td>{{ rewrite.debug_mode }}</td></tr>
        <tr><th>Queries Analyzed</th><td>{{ rewrite.queries_analyzed }}</td></tr>
        <tr><th>Clause Spike Threshold</th><td>{{ rewrite.clause_spike_threshold }}</td></tr>
      </table>
      <h3>Top Clause Deltas</h3>
      <table>
        <thead>
          <tr>
            <th>Query ID</th>
            <th>Raw Query</th>
            <th>Clause Δ</th>
            <th>Flags</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rewrite.top_clause_deltas or [] %}
          <tr>
            <td>{{ row.query_id }}</td>
            <td>{{ row.raw_line }}</td>
            <td>{{ row.clause_delta }}</td>
            <td>{{ row.risk_flags }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <h3>Top Synonym-Changed Queries</h3>
      <table>
        <thead>
          <tr>
            <th>Query ID</th>
            <th>Raw Query</th>
            <th>Hints</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rewrite.top_synonym_changed or [] %}
          <tr>
            <td>{{ row.query_id }}</td>
            <td>{{ row.raw_line }}</td>
            <td>{{ row.synonym_hints }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% for row in rewrite.per_query or [] %}
      <details>
        <summary>Rewrite Query {{ row.query_id }} | Clause Δ {{ row.clause_delta }} | Flags {{ row.risk_flags }}</summary>
        <p class="muted">
          Parsed baseline: <code>{{ row.baseline.parsedquery_toString }}</code><br/>
          Parsed shadow: <code>{{ row.shadow.parsedquery_toString }}</code>
        </p>
        <pre>{{ row }}</pre>
      </details>
      {% endfor %}
      {% else %}
      <p class="muted">Rewrite diff was not enabled for this run.</p>
      {% endif %}
    </div>

    <div class="card" id="ltr-impact">
      <h2>LTR Impact</h2>
      {% set ltr = report.ltr_impact or {} %}
      {% if ltr.enabled %}
      <pre>{{ ltr }}</pre>
      {% else %}
      <p class="muted">{{ ltr.reason if ltr.reason else "LTR impact not available." }}</p>
      {% endif %}
    </div>

    <div class="card">
      <h2>Vector &amp; Hybrid Simulation</h2>
      {% set vh = report.vector_hybrid_simulation or {} %}
      {% if vh.enabled %}
      <p class="muted">Comparison mode: {{ vh.comparison_mode }} | TopK: {{ vh.topK }}</p>
      <h3>Scenario Summary</h3>
      <table>
        <thead>
          <tr>
            <th>Scenario</th>
            <th>Mode</th>
            <th>Avg Overlap Ratio</th>
            <th>Avg Jaccard</th>
            <th>Avg Tau</th>
            <th>Avg QTime</th>
          </tr>
        </thead>
        <tbody>
          {% for row in vh.scenario_summaries or [] %}
          <tr>
            <td>{{ row.scenario_name }}</td>
            <td>{{ row.mode }}</td>
            <td>{{ "%.3f"|format(row.avg_overlap_ratio) }}</td>
            <td>{{ "%.3f"|format(row.avg_jaccard) }}</td>
            <td>{{ "%.3f"|format(row.avg_kendall_tau) }}</td>
            <td>{{ "%.2f"|format(row.avg_qtime) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <h3>Contribution Estimate</h3>
      {% for scenario_name, contribution in (vh.hybrid_contribution or {}).items() %}
      <details>
        <summary>{{ scenario_name }} | lexical est {{ "%.2f"|format(contribution.summary.avg_contribution_lexical_estimate if contribution.summary else 0.0) }} | vector est {{ "%.2f"|format(contribution.summary.avg_contribution_vector_estimate if contribution.summary else 0.0) }}</summary>
        <pre>{{ contribution }}</pre>
      </details>
      {% endfor %}

      {% if vh.narratives %}
      <h3>Narrative</h3>
      <ul>
        {% for line in vh.narratives %}
        <li>{{ line }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      {% set sens = report.hybrid_sensitivity or {} %}
      {% if sens.enabled %}
      <h3>Weight Sensitivity</h3>
      {% for scenario in sens.scenarios or [] %}
      <details>
        <summary>{{ scenario.scenario_name }} | top1 flip % {{ "%.2f"|format(scenario.top1_flip_percent) }}</summary>
        <pre>{{ scenario }}</pre>
      </details>
      {% endfor %}
      {% endif %}
      {% else %}
      <p class="muted">Vector/hybrid simulation was not enabled for this run.</p>
      {% endif %}
    </div>

    <div class="card">
      <h2>Per Query Details</h2>
      {% for diff in report.per_query_diffs %}
      <details>
        <summary>Query {{ diff.query_id }} | {{ diff.raw_line }} | Risk {{ diff.risk_severity }}</summary>
        <p class="muted">
          numFound: baseline={{ diff.numfound_baseline if diff.numfound_baseline is not none else "n/a" }},
          shadow={{ diff.numfound_shadow if diff.numfound_shadow is not none else "n/a" }},
          delta={{ diff.numfound_delta if diff.numfound_delta is not none else "n/a" }},
          sort instability={{ "%.3f"|format(diff.sort_instability_ratio) if diff.sort_instability_ratio is not none else "n/a" }}
        </p>
        {% if diff.facet_diffs %}
        <details>
          <summary>Facet Diffs</summary>
          <pre>{{ diff.facet_diffs }}</pre>
        </details>
        {% endif %}
        <pre>{{ diff }}</pre>
      </details>
      {% endfor %}
    </div>

    <div class="card">
      <h2>Embedded JSON</h2>
      <pre>{{ report_json }}</pre>
    </div>
  </div>
</body>
</html>
